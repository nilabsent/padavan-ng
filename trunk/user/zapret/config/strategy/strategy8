### All arguments here: https://github.com/bol-van/zapret

### http: filter all domains, exept exclude.list
--filter-tcp=80
--dpi-desync=hostfakesplit
--dpi-desync-fooling=md5sig
--dpi-desync-repeats=2
--hostlist-exclude=/etc/storage/zapret/exclude.list

### https: filter all domains, exept exclude.list
--new --filter-tcp=443
--dpi-desync=fake,fakedsplit
--dpi-desync-fakedsplit-mod=altorder=1
--dpi-desync-fakedsplit-pattern=/usr/share/zapret/fake/tls_clienthello_www_google_com.bin
--dpi-desync-split-pos=2,midsld
--dpi-desync-fooling=badseq
--dpi-desync-badseq-increment=0x10000000
--dpi-desync-split-seqovl=2
--dpi-desync-split-seqovl-pattern=/usr/share/zapret/fake/tls_clienthello_www_google_com.bin
--dpi-desync-fake-tls-mod=rnd,dupsid,sni=www.google.com
--hostlist-exclude=/etc/storage/zapret/exclude.list

### quic
--new --filter-udp=443
--dpi-desync=fake --dpi-desync-repeats=6
--dpi-desync-fake-quic=/usr/share/zapret/fake/quic_initial_www_google_com.bin
--hostlist-exclude=/etc/storage/zapret/exclude.list

### games
--new --filter-udp=21000-21500,65530-65535
--dpi-desync=fake
--dpi-desync-cutoff=n2
--dpi-desync-any-protocol=1
--dpi-desync-autottl=2
--dpi-desync-repeats=6
--dpi-desync-fake-unknown-udp=/usr/share/zapret/fake/quic_initial_www_google_com.bin

### wireguard, discord, stun
--new --filter-udp=*
--dpi-desync=fake --filter-l7=wireguard,discord,stun
--dpi-desync-cutoff=n2
--dpi-desync-repeats=6
--dpi-desync-fake-discord=/usr/share/zapret/fake/quic_initial_www_google_com.bin
--dpi-desync-fake-wireguard=/usr/share/zapret/fake/quic_initial_www_google_com.bin
--dpi-desync-fake-stun=/usr/share/zapret/fake/quic_initial_www_google_com.bin
