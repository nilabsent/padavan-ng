### All arguments here: https://github.com/bol-van/zapret2
### To enable ts fooling in Windows: netsh interface tcp set global timestamps=enabled

--blob=quic_google:@/usr/share/zapret/fake/quic_initial_www_google_com.bin
--blob=tls_google:@/usr/share/zapret/fake/tls_clienthello_www_google_com.bin
--blob=stun:@/usr/share/zapret/fake/stun.bin
--blob=blank:0x00000000000000000000000000000000

### https, http
--filter-tcp=443,80
--filter-l7=http,tls
<HOSTLIST>
#--hostlist-exclude=/etc/storage/zapret/exclude.list
--payload=tls_client_hello
--in-range=-s5556
--lua-desync=circular:fails=1:retrans=2:reset
--in-range=x
--lua-desync=fake:blob=0x1603030000:tcp_seq=10000:strategy=1
--lua-desync=multisplit:pos=midsld:seqovl=5:seqovl_pattern=0x1603030001:strategy=1
--lua-desync=fake:blob=0x1703030000:tcp_seq=10000:strategy=2
--lua-desync=multidisorder:pos=1,midsld:strategy=2
--lua-desync=fake:blob=fake_default_tls:tcp_md5:tls_mod=rnd,dupsid,padencap:strategy=3
--lua-desync=fakedsplit:pos=midsld:tcp_seq=10000:strategy=3
--lua-desync=fake:blob=0x1603010000:tcp_seq=10000:strategy=4
--lua-desync=hostfakesplit:host=ozon.ru:midhost=midsld:tcp_ts_up:strategy=4
--lua-desync=fake:blob=0x1503030000:tcp_seq=10000:strategy=5
--lua-desync=multisplit:pos=2,sld:strategy=5
--lua-desync=fake:blob=fake_default_tls:tls_mod=rnd,dupsid,padencap:tcp_ts=-600000:strategy=6
--lua-desync=fakeddisorder:pos=1,sniext+1,host+1,midsld-2,midsld,midsld+2,endhost-1:pattern=blank:seqovl=821:seqovl_pattern=tls_google:tcp_ack=-66000:tcp_ts_up:strategy=6
--payload=http_req
--lua-desync=hostfakesplit:repeats=2:tcp_md5

### quic
--new
--filter-udp=443
--filter-l7=quic
<HOSTLIST_NOAUTO>
#--hostlist-exclude=/etc/storage/zapret/exclude.list
--payload=quic_initial
--lua-desync=fake:blob=quic_google:repeats=6

