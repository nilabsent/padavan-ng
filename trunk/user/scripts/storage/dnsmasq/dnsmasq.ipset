### chatgpt
ipset=/chatgpt.com/cdn.oaistatic.com/oaiusercontent.com/openai.com/unblock_chatgpt

### spotify
ipset=/:.*spotify.*:/scdn.co/pscdn.co/spoti.fi/unblock_spotify

### linkedin
ipset=/linkedin.com/licdn.com/unblock_linkedin

### meta, facebook, instagram, whatsapp
ipset=/instagram.com/ig.me/cdninstagram.com/meta.ai/unblock_meta
ipset=/fb.com/facebook.com/facebook.net/fbcdn.net/fbsbx.com/internalfb.com/unblock_meta
